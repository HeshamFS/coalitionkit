{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "daily-life help needed",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "day": {
      "enum": ["mon", "tue", "wed", "thu", "fri", "sat", "sun"],
      "description": "The day the help is needed."
    },
    "place_kind": {
      "enum": ["home", "shop", "clinic", "station", "other"],
      "description": "The kind of place, never the address."
    },
    "duration_minutes": { "type": "integer", "minimum": 5, "maximum": 720 }
  },
  "required": ["day", "place_kind", "duration_minutes"]
}
