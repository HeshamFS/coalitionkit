{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "world-tour I can show",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "stop_kind": { "enum": ["food", "view", "museum", "street", "market", "any"] },
    "minutes": { "type": "integer", "minimum": 1, "maximum": 60 },
    "note": {
      "type": "string",
      "maxLength": 280,
      "description": "One line the others see: the stop and why. Never a street address."
    },
    "street_address": { "type": "string", "x-private": true },
    "phone": { "type": "string", "x-private": true }
  },
  "required": ["minutes"]
}
