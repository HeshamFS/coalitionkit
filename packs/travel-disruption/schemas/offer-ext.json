{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://packs.example.invalid/travel-disruption/offer-ext.json",
  "type": "object",
  "properties": {
    "destination": { "type": "string", "minLength": 1, "maxLength": 64 },
    "departure": { "type": "string", "format": "date-time" },
    "seats": { "type": "integer", "minimum": 1, "maximum": 60 },
    "price": { "type": "string", "pattern": "^EUR [0-9]{1,6}([.][0-9]{2})?$" }
  },
  "required": ["destination", "departure", "seats", "price"],
  "additionalProperties": false
}
