{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coalitionkit.dev/schemas/coalition/v0/tool.json",
  "title": "coalition.tool",
  "description": "Host to members: one activity the host observed, such as a model call, a PSI round, a Steward review or an outside agent's tool call.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "seat",
    "agent",
    "tool",
    "args",
    "result",
    "status",
    "ms",
    "refs"
  ],
  "properties": {
    "seat": {
      "$ref": "common.json#/$defs/id"
    },
    "agent": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32
    },
    "tool": {
      "type": "string",
      "pattern": "^[a-z0-9_]+:[a-z0-9_.-]+$",
      "maxLength": 64
    },
    "args": {
      "type": "string",
      "maxLength": 200
    },
    "result": {
      "type": "string",
      "maxLength": 200
    },
    "status": {
      "enum": [
        "started",
        "done",
        "failed"
      ]
    },
    "ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "refs": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "$ref": "common.json#/$defs/ulid"
      }
    }
  }
}
