{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coalitionkit.dev/schemas/coalition/v0/ripple.json",
  "title": "coalition.ripple",
  "description": "Any participant: a change and the tasks it invalidates.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "change",
    "invalidates"
  ],
  "properties": {
    "change": {
      "type": "string",
      "minLength": 1
    },
    "invalidates": {
      "type": "array",
      "items": {
        "$ref": "common.json#/$defs/id"
      },
      "uniqueItems": true
    }
  }
}
