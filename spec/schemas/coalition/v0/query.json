{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coalitionkit.dev/schemas/coalition/v0/query.json",
  "title": "coalition.query",
  "description": "Host to vault: a typed question.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "query_id",
    "kind",
    "subject"
  ],
  "properties": {
    "query_id": {
      "$ref": "common.json#/$defs/id"
    },
    "kind": {
      "enum": [
        "feasible",
        "cost",
        "availability"
      ]
    },
    "subject": {
      "$ref": "common.json#/$defs/id"
    },
    "deadline_ms": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991,
      "default": 10000,
      "description": "Optional; a missing value means 10,000 (a pack may change the default)."
    }
  }
}
