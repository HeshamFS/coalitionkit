{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coalitionkit.dev/schemas/coalition/v0/common.json",
  "title": "Shared definitions",
  "$defs": {
    "ulid": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "datetime": {
      "type": "string",
      "format": "date-time"
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "money": {
      "type": "integer",
      "minimum": 0,
      "description": "Minor units (cents)",
      "maximum": 9007199254740991
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "amount",
        "currency"
      ],
      "properties": {
        "amount": {
          "$ref": "#/$defs/money"
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        }
      }
    },
    "cost": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minutes",
        "money",
        "effort"
      ],
      "properties": {
        "minutes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "money": {
          "$ref": "#/$defs/money"
        },
        "effort": {
          "enum": [
            "low",
            "medium",
            "high"
          ]
        }
      }
    },
    "window": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start",
        "end"
      ],
      "properties": {
        "start": {
          "$ref": "#/$defs/datetime"
        },
        "end": {
          "$ref": "#/$defs/datetime"
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id"
      ],
      "properties": {
        "kind": {
          "enum": [
            "need",
            "task"
          ]
        },
        "id": {
          "$ref": "#/$defs/ulid"
        }
      }
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id",
        "revision"
      ],
      "description": "The one reference shape for what a decision, consent request or revision check is about. The host assigns revisions: 1 at creation, +1 on every change.",
      "properties": {
        "kind": {
          "enum": [
            "plan",
            "tension_option",
            "commitment",
            "charter",
            "task"
          ]
        },
        "id": {
          "$ref": "#/$defs/ulid"
        },
        "revision": {
          "$ref": "#/$defs/revision"
        }
      }
    },
    "ed25519_jwk": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kty",
        "crv",
        "x",
        "kid"
      ],
      "description": "An Ed25519 public key as a JWK (RFC 8037).",
      "properties": {
        "kty": {
          "const": "OKP"
        },
        "crv": {
          "const": "Ed25519"
        },
        "x": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{43}$"
        },
        "kid": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "detached_jws": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+\\.\\.[A-Za-z0-9_-]+$",
      "description": "Compact JWS with a detached payload: <protected>..<signature>"
    },
    "sha256_hex": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
