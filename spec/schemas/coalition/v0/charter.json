{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coalitionkit.dev/schemas/coalition/v0/charter.json",
  "title": "coalition.charter",
  "description": "Host to members: the Coalition's goal, roles, rules and deadline.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "goal",
    "roles",
    "rules",
    "deadline",
    "deciders",
    "revision",
    "created_at"
  ],
  "properties": {
    "goal": {
      "type": "string",
      "minLength": 1
    },
    "roles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "$ref": "common.json#/$defs/id"
          },
          "required": {
            "type": "boolean"
          }
        }
      }
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "deadline": {
      "$ref": "common.json#/$defs/datetime"
    },
    "pack": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "$ref": "common.json#/$defs/id"
        },
        "version": {
          "$ref": "common.json#/$defs/id"
        }
      }
    },
    "budget": {
      "$ref": "common.json#/$defs/budget"
    },
    "deciders": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "common.json#/$defs/id"
      },
      "uniqueItems": true
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "created_at": {
      "$ref": "common.json#/$defs/datetime",
      "description": "When the host created the Coalition (input of the genesis hash). Identical in every revision."
    },
    "count_trusted": {
      "type": "array",
      "items": {
        "$ref": "common.json#/$defs/id"
      },
      "uniqueItems": true,
      "description": "Participants a vault may accept as requester of a PSI exchange with reveal 'count' (v0.1 PSI is semi-honest only). Absent means nobody."
    }
  }
}
