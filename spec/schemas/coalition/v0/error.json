{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coalitionkit.dev/schemas/coalition/v0/error.json",
  "title": "coalition.error",
  "description": "Host to sender: why an envelope was rejected. Scoped to its sender.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "code",
    "detail",
    "ref"
  ],
  "properties": {
    "code": {
      "enum": [
        "schema_invalid",
        "bad_signature",
        "sender_mismatch",
        "unknown_participant",
        "extension_not_activated",
        "stage_mismatch",
        "scope_violation",
        "not_a_decider",
        "stale_subject",
        "steward_blocked",
        "deadline_exceeded",
        "rate_limited",
        "budget_exhausted",
        "pack_violation"
      ]
    },
    "detail": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "message": {
          "type": "string"
        },
        "policy_id": {
          "$ref": "common.json#/$defs/id"
        },
        "retry_after_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "ref": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
      "description": "event_id of the envelope this answers"
    }
  }
}
