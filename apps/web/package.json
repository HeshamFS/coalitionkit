{
  "name": "@coalitionkit/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "prebuild": "tsc --noEmit",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:ci": "vitest run --maxWorkers=2",
    "test:e2e": "playwright test",
    "shots": "playwright test --project=gallery",
    "build:mcp": "node scripts/build.mjs --mcp-only",
    "test:doors": "playwright test -c playwright.doors.config.ts",
    "pretest:doors": "node scripts/build.mjs --mcp-only"
  },
  "dependencies": {
    "@a2ui/react": "0.14.0",
    "@a2ui/web_core": "0.14.0",
    "@ag-ui/client": "1.0.3",
    "@ag-ui/core": "1.0.3",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource/instrument-serif": "5.3.0",
    "fast-json-patch": "3.1.1",
    "jsqr": "1.4.0",
    "qrcode-generator": "2.0.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@modelcontextprotocol/client": "2.4.0",
    "@modelcontextprotocol/core": "2.4.0",
    "@modelcontextprotocol/ext-apps": "2.0.4",
    "@playwright/test": "1.64.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "30.1.3",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vite-plugin-singlefile": "2.3.4",
    "vitest": "5.0.5"
  },
  "overrides": {
    "@modelcontextprotocol/ext-apps": {
      "zod": "$zod"
    },
    "@modelcontextprotocol/client": {
      "zod": "$zod"
    },
    "dompurify": "3.4.17"
  }
}
